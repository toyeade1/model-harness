#!/usr/bin/env sh
PRG="$0"
while [ -h "$PRG" ]; do
  DIR="$(CDPATH= cd -- "$(dirname -- "$PRG")" && pwd)"
  LINK="$(readlink "$PRG")"
  case "$LINK" in
    /*) PRG="$LINK" ;;
    *) PRG="$DIR/$LINK" ;;
  esac
done
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$PRG")" && pwd)"
exec node "$SCRIPT_DIR/../src/cli.mjs" "$@"
